{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        {% if warning_telephone %}
          <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ warning_telephone }}</div>
        {% endif %}
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ tab_general }}</a></li>
            <li class="nav-item"><a href="#tab-sender" data-bs-toggle="tab" class="nav-link">{{ tab_sender }}</a></li>
            <li class="nav-item"><a href="#tab-services" data-bs-toggle="tab" class="nav-link">{{ tab_services }}</a></li>
            <li class="nav-item"><a href="#tab-orders" data-bs-toggle="tab" class="nav-link">{{ tab_orders }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3 required">
                <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_parcora_api_key" value="{{ shipping_parcora_api_key }}" placeholder="dp_test_…" id="input-api-key" class="form-control"/>
                  <div class="form-text">{{ help_api_key }}</div>
                  <div id="error-api-key" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-base-url" class="col-sm-2 col-form-label">{{ entry_base_url }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_parcora_base_url" value="{{ shipping_parcora_base_url }}" placeholder="https://api.parcora.eu" id="input-base-url" class="form-control"/>
                  <div class="form-text">{{ help_base_url }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_tax_class_id" id="input-tax-class" class="form-select">
                    <option value="0">{{ text_none }}</option>
                    {% for tax_class in tax_classes %}
                      <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_parcora_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_geo_zone_id" id="input-geo-zone" class="form-select">
                    <option value="0">{{ text_all_zones }}</option>
                    {% for geo_zone in geo_zones %}
                      <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_parcora_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-default-weight" class="col-sm-2 col-form-label">{{ entry_default_weight }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_parcora_default_weight" value="{{ shipping_parcora_default_weight }}" id="input-default-weight" class="form-control"/>
                  <div class="form-text">{{ help_default_weight }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="shipping_parcora_status" value="0"/>
                    <input type="checkbox" name="shipping_parcora_status" value="1" id="input-status" class="form-check-input"{% if shipping_parcora_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_parcora_sort_order" value="{{ shipping_parcora_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
                </div>
              </div>
            </div>
            <div id="tab-sender" class="tab-pane">
              {% for field in ['name', 'phone', 'email', 'line1', 'city', 'postcode'] %}
                <div class="row mb-3{% if field not in ['phone', 'email'] %} required{% endif %}">
                  <label for="input-sender-{{ field }}" class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_' ~ field) }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="shipping_parcora_sender_{{ field }}" value="{{ attribute(_context, 'shipping_parcora_sender_' ~ field) }}" id="input-sender-{{ field }}" class="form-control"/>
                  </div>
                </div>
              {% endfor %}
              <div class="row mb-3 required">
                <label for="input-sender-country" class="col-sm-2 col-form-label">{{ entry_country }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_sender_country" id="input-sender-country" class="form-select">
                    <option value="0">{{ text_none }}</option>
                    {% for country in countries %}
                      <option value="{{ country.country_id }}"{% if country.country_id == shipping_parcora_sender_country %} selected{% endif %}>{{ country.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
            </div>
            <div id="tab-services" class="tab-pane">
              {% if error_carriers %}
                <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_carriers }}</div>
              {% endif %}
              {% if services %}
                <div class="table-responsive">
                  <table class="table table-bordered table-hover">
                    <thead>
                      <tr>
                        <td>{{ column_service }}</td>
                        <td class="text-center">{{ column_enabled }}</td>
                        <td>{{ column_title }}</td>
                        <td>{{ column_mode }}</td>
                        <td>{{ column_markup_percent }}</td>
                        <td>{{ column_markup_amount }}</td>
                        <td>{{ column_fixed }}</td>
                        <td>{{ column_free_from }}</td>
                      </tr>
                    </thead>
                    <tbody>
                      {% for service in services %}
                        {% set name = 'shipping_parcora_services[' ~ service.code ~ ']' %}
                        <tr>
                          <td><strong>{{ service.carrier }}</strong><br/><code>{{ service.code }}</code><br/>
                            <span class="badge {% if service.connected %}bg-success{% else %}bg-secondary{% endif %}">{% if service.connected %}{{ text_connected }}{% else %}{{ text_not_connected }}{% endif %}</span></td>
                          <td class="text-center">
                            <input type="hidden" name="{{ name }}[carrier]" value="{{ service.carrier }}"/>
                            <input type="hidden" name="{{ name }}[enabled]" value="0"/>
                            <input type="checkbox" name="{{ name }}[enabled]" value="1" class="form-check-input"{% if service.setting.enabled %} checked{% endif %}/>
                          </td>
                          <td><input type="text" name="{{ name }}[title]" value="{{ service.setting.title }}" placeholder="{{ help_title }}" class="form-control"/></td>
                          <td>
                            <select name="{{ name }}[mode]" class="form-select">
                              <option value="api"{% if service.setting.mode == 'api' %} selected{% endif %}>{{ text_mode_api }}</option>
                              <option value="fixed"{% if service.setting.mode == 'fixed' %} selected{% endif %}>{{ text_mode_fixed }}</option>
                            </select>
                          </td>
                          <td><input type="text" name="{{ name }}[markup_percent]" value="{{ service.setting.markup_percent }}" class="form-control"/></td>
                          <td><input type="text" name="{{ name }}[markup_amount]" value="{{ service.setting.markup_amount }}" class="form-control"/></td>
                          <td><input type="text" name="{{ name }}[fixed]" value="{{ service.setting.fixed }}" class="form-control"/></td>
                          <td><input type="text" name="{{ name }}[free_from]" value="{{ service.setting.free_from }}" title="{{ help_free_from }}" class="form-control"/></td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% elseif not error_carriers %}
                <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_no_services }}</div>
              {% endif %}
            </div>
            <div id="tab-orders" class="tab-pane">
              <div class="row mb-3">
                <label for="input-create-status" class="col-sm-2 col-form-label">{{ entry_create_status }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_create_status_id" id="input-create-status" class="form-select">
                    <option value="0">{{ text_manual }}</option>
                    {% for order_status in order_statuses %}
                      <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == shipping_parcora_create_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-delivered-status" class="col-sm-2 col-form-label">{{ entry_delivered_status }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_delivered_status_id" id="input-delivered-status" class="form-select">
                    <option value="0">{{ text_none }}</option>
                    {% for order_status in order_statuses %}
                      <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == shipping_parcora_delivered_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-label-format" class="col-sm-2 col-form-label">{{ entry_label_format }}</label>
                <div class="col-sm-10">
                  <select name="shipping_parcora_label_format" id="input-label-format" class="form-select">
                    <option value="">{{ text_carrier_default }}</option>
                    {% for code, label_format in label_formats %}
                      <option value="{{ code }}"{% if code == shipping_parcora_label_format %} selected{% endif %}>{{ label_format }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label class="col-sm-2 col-form-label">{{ entry_webhook }}</label>
                <div class="col-sm-10">
                  <p class="form-control-plaintext">{% if webhook_id %}{{ text_webhook_on|format(webhook_id) }}{% else %}{{ text_webhook_off }}{% endif %}</p>
                  <button type="button" id="button-webhook" class="btn btn-outline-primary"><i class="fa-solid fa-bolt"></i> {{ button_webhook }}</button>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-webhook').on('click', function() {
    var element = this;

    $.ajax({
        url: '{{ webhook|escape('js') }}',
        type: 'post',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
